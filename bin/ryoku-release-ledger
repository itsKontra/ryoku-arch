#!/usr/bin/env bash
# ryoku-release-ledger: rebuild releases/index.json from what the bucket holds.
#
# The ledger is derived, never edited: every releases/<tag>/x86_64/release.json
# in the bucket is one entry (tag, name, version, commit, date, repo), newest
# first by date, and `latest` is the newest. publish-repo.yml runs this after a
# release lands and release-ledger.yml runs it on demand, so a ledger that was
# lost, truncated, or written by an older publish heals on the next run. The
# Hub's Updates page, `ryoku rollback` (the list it offers) and the site read
# it.
#
# usage: ryoku-release-ledger <rclone remote:bucket>   (writes the ledger, prints it)
# needs: rclone (configured, see bin/ryoku-r2-config), jq
set -euo pipefail
remote=${1:?usage: ryoku-release-ledger <rclone remote:bucket>}

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

mapfile -t tags < <(rclone lsf "$remote/releases/" --dirs-only 2>/dev/null | sed 's|/$||' | grep -E '^v[0-9]' || true)
entries=()
for tag in "${tags[@]}"; do
  if ! rclone cat "$remote/releases/$tag/x86_64/release.json" > "$tmp/$tag.json" 2>/dev/null || [[ ! -s "$tmp/$tag.json" ]]; then
    echo "ryoku-release-ledger: $tag has no release.json; skipped" >&2
    continue
  fi
  entries+=("$(jq -c --arg tag "$tag" --arg repo "releases/$tag/x86_64" \
    '{tag: $tag, name: (.name // ""), version: .version, commit: .commit, date: .date, repo: $repo}' "$tmp/$tag.json")")
done

if (( ${#entries[@]} == 0 )); then
  echo '{"schema":1,"latest":"","releases":[]}' > "$tmp/index.json"
else
  printf '%s\n' "${entries[@]}" | jq -s '
    sort_by(.date) | reverse
    | {schema: 1, latest: (.[0].tag // ""), releases: .}' > "$tmp/index.json"
fi
[[ -s "$tmp/index.json" ]] || { echo "ryoku-release-ledger: produced an empty ledger; refusing to upload" >&2; exit 1; }
rclone copyto "$tmp/index.json" "$remote/releases/index.json" --header-upload "Cache-Control: no-cache, must-revalidate"
cat "$tmp/index.json"
